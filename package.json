{
  "name": "opendoc",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @opendoc/web --filter @opendoc/api dev",
    "dev:web": "pnpm --filter @opendoc/web dev",
    "dev:api": "pnpm --filter @opendoc/api dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "db:up": "podman compose up -d postgres"
  }
}
