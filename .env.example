# Conta do responsável pela instalação, criada no primeiro start enquanto não houver contas.
# Senha de 15 a 128 caracteres.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# API (apps/api)
HOST=127.0.0.1
PORT=4173
# Endereço público do app web: monta os links de convite e é a origem aceita em POST/PUT/PATCH/DELETE.
APP_URL=http://localhost:5173
# Outras origens aceitas, separadas por vírgula (opcional).
# ALLOWED_ORIGINS=

# PostgreSQL (podman compose up -d postgres)
POSTGRES_DB=opendoc
POSTGRES_USER=opendoc
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# A API roda no host: use 127.0.0.1. Codifique a senha na URL se tiver caracteres especiais.
DATABASE_URL=postgresql://opendoc:<senha>@127.0.0.1:5432/opendoc

# Obrigatória: criptografa os segredos do autenticador. Gere uma vez com: openssl rand -base64 32
# Guarde junto com o backup do banco; sem ela ninguém consegue entrar.
MFA_ENCRYPTION_KEY=

# Em produção: NODE_ENV=production atrás de HTTPS (os cookies ficam Secure e com prefixo __Host-).
# NODE_ENV=production
# COOKIE_SECURE=true
# true só atrás de um proxy reverso confiável.
TRUST_PROXY=false
